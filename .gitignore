/target
**/*.rs.bk
Cargo.lock.bak

# Assets — the scenes and exports made while trying something out. They live in
# whoever made them's own asset dirs, not here; a test slime that lands in the
# repo root while debugging an export should not have to be remembered about.
*.demiurg
*.demiurg.bak
*.rkc
*.rvc
*.blend
*.blend1

# Screenshots dropped at the root to point at something in a conversation. The
# ones the docs use are under screenshots/ and stay tracked, hence the anchor.
/*.png

# Build output: the wasm bundle (trunk) and the packaged Blender addon.
/dist

# Python bytecode from the Blender addon (Blender writes it next to the
# sources on import, and the tests do too).
__pycache__/
*.pyc

# `nix build` result symlink.
/result
